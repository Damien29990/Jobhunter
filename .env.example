# Copy this file to .env and replace the placeholders with your real keys.
#   copy .env.example .env
# Do not commit .env.

# === Required — pipeline will not run without these ===

# Canonical names used by every agent (see src/agents/env_keys.py):
#   TAVILY_API_KEY
#   DEEPSEEK_API_KEY
# Aliases still accepted: TAVILY_KEY, DEEPSEEK_KEY, OPENAI_API_KEY (SDK class name only).

# Tavily web search API (Rex job search + Dana background research + optional LinkedIn profile seed)
# Get one at https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# DeepSeek LLM API (all agents: JD evaluation, dossier distillation, CV tailoring)
# Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# === Telegram notifications (optional — skipped if not set) ===

# Bot token from @BotFather in Telegram (send /newbot)
TELEGRAM_BOT_TOKEN=

# Your chat ID (send a message to your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find it)
# With FastAPI hosting, Clara follow-up: /clara  /clara 110 APPLIED  (buttons on Clara pings)
TELEGRAM_CHAT_ID=

# Public @username (without @). Used for the dashboard t.me link.
# If omitted, the API calls Telegram getMe to resolve it.
# TELEGRAM_BOT_USERNAME=YourBotUsername

# === Scheduler (optional — default: twice daily at 9am + 6pm HKT) ===

# Comma-separated hours in 24h format (e.g. 9,18 or 8,12,18)
SCHEDULER_HOURS=9,18

# Optional System One — Laya (local) or hosted Jev. Heuristic gates run without this.
# Local: pip install laya && laya-serve   then:
# LAYA_BASE_URL=http://127.0.0.1:8080
# SYSTEM_ONE_BACKEND=auto
# SYSTEM_ONE_MODEL=laya
# Hosted TypeSafe Jev (same /v1/systemone shape):
# TYPESAFE_API_KEY=
# SYSTEM_ONE_MODEL=jev-latest

# DeepSeek model ID. Default: deepseek-v4-flash
# DEEPSEEK_MODEL=deepseek-v4-flash

# Agent 2 (Dana) web search. Default official = Wikipedia / Wikidata / company
# sites via HTTP — no Tavily credits. Set tavily only when you want paid lanes.
DUE_DILIGENCE_BACKEND=official

# Milo (Agent 0) local Ollama model for CV parsing + chatbot + PAC extraction
# MILO_OLLAMA_MODEL=gemma4:e2b

# Embedding backend: "lexical" (offline feature-hash, no deps) or "fastembed" (needs fastembed installed)
# EMBEDDING_BACKEND=lexical

# FastEmbed model name (only used if EMBEDDING_BACKEND=fastembed)
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# LinkedIn MCP is owned by Jobhunter agents (Milo import), not Cursor.
# FastAPI spawns: uvx linkedin-api-mcp → get_profile
# Store the li_at cookie in Windows Credential Manager via:
#   uvx linkedin-api-mcp auth
# Or set LINKEDIN_COOKIE in this file (do not commit). Never paste it in chat.
# LINKEDIN_MCP_COMMAND=uvx
# LINKEDIN_MCP_ARGS=linkedin-api-mcp
# LINKEDIN_MCP_TOOL=get_profile
# LINKEDIN_MCP_TIMEOUT_SEC=120
# LINKEDIN_COOKIE=

# === Scheduler advanced (optional — rarely needed) ===

# Candidate ID for scheduled runs (default: "default")
# SCHEDULER_CANDIDATE_ID=default

# Profile path override for scheduled runs (default: config/master_profile.json)
# SCHEDULER_PROFILE_PATH=

# Extra search keywords for scheduled runs (default: none)
# SCHEDULER_QUERY=

# Rex (talent scout) run caps. JD DeepSeek evals are uncapped.
# REX_TAVILY_MAX_CALLS counts search + extract (default 16 ≈ four tracks × four lanes).
# REX_MAX_SEARCH_TRACKS=5
# REX_TAVILY_MAX_CALLS=16
# REX_MAX_COMPLETION_TOKENS=2048
# REX_EVAL_JD_CHARS=8000
# REX_TAVILY_MAX_RESULTS=5
#
# Tavily credits: basic search = 1, advanced = 2. Default is basic to stop
# Dana burning ~14 credits per company (2 aliases × 3 lanes + general, advanced).
# TAVILY_SEARCH_DEPTH=basic
# DANA_TAVILY_MAX_CALLS=40
# DANA_TAVILY_ALIAS_LIMIT=1
